<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: title + date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Health Tracker"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A"/>
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#5A7A9A"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0EAF4"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>

    <!-- Progress -->
    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-- of -- doses today"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1B5FA8"/>

    <!-- Next dose -->
    <TextView
        android:id="@+id/widget_next_dose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next: --"
        android:textSize="12sp"
        android:textColor="#2C4A6E"
        android:layout_marginTop="3dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0EAF4"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_heart_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&#x2665; --"
            android:textSize="11sp"
            android:textColor="#E74C3C"/>
        <TextView
            android:id="@+id/widget_blood_pressure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BP --"
            android:textSize="11sp"
            android:textColor="#C0392B"/>
    </LinearLayout>

</LinearLayout>
