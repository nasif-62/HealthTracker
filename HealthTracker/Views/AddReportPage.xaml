<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthTracker.ViewModels"
             x:Class="HealthTracker.Views.AddReportPage"
             Title="Add Report">
    <ScrollView>
        <StackLayout Padding="16" Spacing="12">

            <!-- Add Pages -->
            <Label Text="Report Pages" FontAttributes="Bold" FontSize="15" TextColor="#0D1B2A"/>
            <Label Text="Add one or more pages (photos or files). OCR will auto-fill fields from images."
                   TextColor="#5A7A9A" FontSize="12"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Pick File" ImageSource="icon_attach.svg"
                        ContentLayout="Left, 6"
                        Command="{Binding PickFileCommand}"
                        BackgroundColor="#2C4A6E" TextColor="White"/>
                <Button Grid.Column="1" Text="Take Photo" ImageSource="icon_camera.svg"
                        ContentLayout="Left, 6"
                        Command="{Binding CapturePhotoCommand}"
                        BackgroundColor="#2C4A6E" TextColor="White"/>
            </Grid>

            <!-- OCR Status -->
            <Label Text="{Binding OcrStatus}" TextColor="#E67E22" FontSize="12"
                   IsVisible="{Binding HasOcrStatus}" FontAttributes="Italic"/>

            <!-- Pages List -->
            <CollectionView ItemsSource="{Binding Pages}" IsVisible="{Binding HasPages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportPageItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Remove" BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemovePageCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Frame BorderColor="#C8D8EA" Padding="10" Margin="0,2" CornerRadius="6">
                                <Label Text="{Binding FileName}" TextColor="#1B5FA8" FontSize="13"/>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Report Fields -->
            <BoxView HeightRequest="1" Color="#E0EAF4" Margin="0,4" IsVisible="{Binding HasPages}"/>

            <Label Text="Title" FontAttributes="Bold"/>
            <Entry Text="{Binding Title}" Placeholder="e.g. Blood test results"/>

            <Label Text="Report Type" FontAttributes="Bold"/>
            <Picker ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding ReportType}"/>

            <Label Text="Report Date" FontAttributes="Bold"/>
            <DatePicker Date="{Binding ReportDate}"/>

            <Label Text="Doctor (optional)" FontAttributes="Bold"/>
            <Entry Text="{Binding DoctorName}"/>

            <Label Text="Hospital (optional)" FontAttributes="Bold"/>
            <Entry Text="{Binding Hospital}"/>

            <Label Text="Notes (optional)" FontAttributes="Bold"/>
            <Entry Text="{Binding Notes}"/>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" FontSize="13"/>
            <Button Text="Save Report" Command="{Binding SaveCommand}" BackgroundColor="#1B5FA8" TextColor="White"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
