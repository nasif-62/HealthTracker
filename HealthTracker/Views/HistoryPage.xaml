<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthTracker.Views.HistoryPage"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Date range filter -->
        <Frame Grid.Row="0" Margin="12,10,12,4" Padding="12,10" CornerRadius="10" BorderColor="#C8D8EA">
            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
                <Label Grid.Row="0" Grid.Column="0" Text="From" FontSize="11" TextColor="#8BAAC8"/>
                <Label Grid.Row="0" Grid.Column="2" Text="To" FontSize="11" TextColor="#8BAAC8"/>
                <DatePicker Grid.Row="1" Grid.Column="0" Date="{Binding FromDate}" Format="MMM d, yyyy"
                            FontSize="13" TextColor="#0D1B2A"/>
                <Label Grid.Row="1" Grid.Column="1" Text="—" VerticalOptions="Center" TextColor="#8BAAC8"/>
                <DatePicker Grid.Row="1" Grid.Column="2" Date="{Binding ToDate}" Format="MMM d, yyyy"
                            FontSize="13" TextColor="#0D1B2A"/>
                <Button Grid.Row="1" Grid.Column="3" Text="Search" Command="{Binding SearchCommand}"
                        BackgroundColor="#1B5FA8" TextColor="White"
                        FontSize="13" HeightRequest="36" CornerRadius="8" Padding="10,0"/>
            </Grid>
        </Frame>

        <!-- Medicine history (grouped) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding MedicineGroups}"
                        IsGrouped="True"
                        IsVisible="{Binding IsMedicine}">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Frame Margin="12,8,12,2" Padding="12,8" CornerRadius="8"
                           BackgroundColor="#EAF2FB" BorderColor="#C8D8EA">
                        <Label Text="{Binding HeaderText}"
                               FontAttributes="Bold" FontSize="14" TextColor="#0D1B2A"/>
                    </Frame>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="24,2,12,2" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMedicineTapped" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Frame Padding="12,10" CornerRadius="8" BorderColor="#E0EAF4" InputTransparent="True">
                            <StackLayout Spacing="6">
                                <Label Text="{Binding DateRange}" FontSize="12" TextColor="#5A7A9A"/>
                                <Label Text="{Binding SummaryLine}" FontSize="13" TextColor="#2C4A6E"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ProgressBar Grid.Column="0" Progress="{Binding Progress}"
                                                 ProgressColor="{Binding ProgressColor, Converter={StaticResource HexColorConverter}}"
                                                 VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding ProgressText}"
                                           FontSize="11" TextColor="{Binding ProgressColor, Converter={StaticResource HexColorConverter}}"
                                           FontAttributes="Bold" VerticalOptions="Center"/>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No medicine history in this period." HorizontalOptions="Center"
                       TextColor="#8BAAC8" FontSize="14" Margin="0,40"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Doctor history -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding DoctorItems}"
                        IsVisible="{Binding IsDoctor}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,5" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDoctorTapped" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Frame Padding="14,12" CornerRadius="10" BorderColor="#C8D8EA" InputTransparent="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding DoctorName}" FontAttributes="Bold"
                                           FontSize="15" TextColor="#0D1B2A"/>
                                    <Label Text="{Binding SubText}" FontSize="12" TextColor="#5A7A9A"
                                           IsVisible="{Binding SubText, Converter={StaticResource NotNullConverter}}"/>
                                    <Label Text="{Binding Diagnosis}" FontSize="12" TextColor="#2C4A6E"
                                           IsVisible="{Binding Diagnosis, Converter={StaticResource NotNullConverter}}"
                                           LineBreakMode="TailTruncation" MaxLines="2"/>
                                </StackLayout>
                                <Label Grid.Column="1" Text="{Binding VisitDateDisplay}"
                                       FontSize="11" TextColor="#8BAAC8" VerticalOptions="Start"/>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No doctor visits in this period." HorizontalOptions="Center"
                       TextColor="#8BAAC8" FontSize="14" Margin="0,40"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Reports history -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding ReportItems}"
                        IsVisible="{Binding IsReports}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,5" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReportTapped" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Frame Padding="14,12" CornerRadius="10" BorderColor="#C8D8EA" InputTransparent="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Title}" FontAttributes="Bold"
                                           FontSize="15" TextColor="#0D1B2A"/>
                                    <Label Text="{Binding SubText}" FontSize="12" TextColor="#5A7A9A"/>
                                </StackLayout>
                                <Label Grid.Column="1" Text="{Binding ReportDateDisplay}"
                                       FontSize="11" TextColor="#8BAAC8" VerticalOptions="Start"/>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No reports in this period." HorizontalOptions="Center"
                       TextColor="#8BAAC8" FontSize="14" Margin="0,40"/>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
